{
  "name": "time-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-maps.mjs --runtime-only && node scripts/prepare-reading.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-maps.mjs --runtime-only && node scripts/prepare-reading.mjs --catalog-only",
    "build": "tsc -b && vite build && node scripts/build-pages.mjs",
    "build:public": "npm run prebuild && tsc -b && vite build --mode public && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run format:check && npm run data:prepare && npm --ignore-scripts test && npm --ignore-scripts run data:check && npm run data:audit:ci && npm --ignore-scripts run build",
    "pretest": "npm run data:prepare",
    "test": "vitest run && node --test scripts/map-packs.test.mjs scripts/prepare-reading.test.mjs",
    "test:e2e": "playwright test",
    "data:build": "python3 scripts/build_maps.py && npm run data:pack",
    "data:pack": "node scripts/pack-maps.mjs",
    "data:prepare": "node scripts/prepare-maps.mjs && node scripts/prepare-reading.mjs",
    "predata:check": "npm run data:prepare",
    "data:check": "node scripts/check-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:people": "python3 scripts/import_people.py",
    "data:audit": "node scripts/audit-content.mjs && npm run data:docs",
    "data:docs": "node scripts/sync-coverage-readme.mjs --write",
    "data:references": "node scripts/index-research.mjs && python3 scripts/collect-references.py && node scripts/index-research.mjs",
    "data:audit:ci": "node scripts/audit-content.mjs --metadata-only --check && node scripts/sync-coverage-readme.mjs",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:pillar": "playwright test --config playwright.pillar.config.ts",
    "test:e2e:world": "playwright test --config playwright.world.config.ts",
    "test:e2e:refinement": "playwright test --config playwright.refinement.config.ts",
    "test:e2e:journeys": "playwright test --config playwright.journeys.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "transliteration": "^2.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "山河纪 · Time Atlas — 在地图上读历史，在时间中看山河。",
  "license": "(MIT AND CC-BY-4.0)"
}
